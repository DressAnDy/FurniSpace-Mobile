{
  "expo": {
    "name": "FurniSpace Mobile",
    "slug": "dressandy2203",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "furnispace",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow FurniSpace to take photos for project evidence and issue reports.",
        "NSPhotoLibraryUsageDescription": "Allow FurniSpace to upload photos for project evidence and issue reports."
      }
    },
    "android": {
      "package": "com.anonymous.furnispacemobile",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#C9A86A"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FurniSpace to take photos for project evidence and issue reports.",
          "photosPermission": "Allow FurniSpace to upload photos for project evidence and issue reports."
        }
      ],
      "expo-web-browser"
    ],
    "web": {},
    "extra": {
      "eas": {
        "projectId": "a480df44-fb9d-4854-a7c9-67b2674f5925"
      }
    },
    "owner": "dressandy2203s-team"
  }
}
